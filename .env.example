# ─────────────────────────────────────────────────────────────────────────────
# pinterest-ads-mcp-server configuration
# Either a single access token, or the refresh trio. See the README.
# ─────────────────────────────────────────────────────────────────────────────

# Access token from your Pinterest developer app, with the ads:read scope.
PINTEREST_ACCESS_TOKEN=

# Alternative to the token above: refresh credentials, so the server can renew
# the access token itself. All three are needed together.
# PINTEREST_REFRESH_TOKEN=
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=

# Recommended. Comma-separated ad account IDs this server may use. When set,
# requests that name any other ad account are refused before they are sent,
# and account discovery only returns these accounts. When unset, every account
# the token can access is reachable and the server says so on stderr.
# Version 3.0.0 will require it.
PINTEREST_AD_ACCOUNT_IDS=

# Optional. Saves passing adAccountId on every call. When
# PINTEREST_AD_ACCOUNT_IDS is set, it must be one of those accounts.
# PINTEREST_AD_ACCOUNT_ID=

# Write tools are OFF by default. Set to true to register the 30 write tools.
# 1, yes and on still work but are deprecated: version 3.0.0 will accept only
# true. An unrecognized value stops the server at startup. They need the
# ads:write scope, not just ads:read.
# Every write still previews first and applies only on a second call
# with confirm: true.
# PINTEREST_ENABLE_WRITES=true

# debug | info | warn | error
# LOG_LEVEL=info

# API environment: production or sandbox
PINTEREST_ENVIRONMENT=production
