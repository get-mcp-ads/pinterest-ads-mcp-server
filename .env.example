# ─────────────────────────────────────────────────────────────────────────────
# pinterest-ads-mcp-server configuration
# Either a single access token, or the refresh trio. See the README.
# ─────────────────────────────────────────────────────────────────────────────

# Access token from your Pinterest developer app, with the ads:read scope.
PINTEREST_ACCESS_TOKEN=

# Alternative to the token above: refresh credentials, so the server can renew
# the access token itself. All three are needed together.
# PINTEREST_REFRESH_TOKEN=
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=

# Required. Comma-separated ad account IDs this server may use. Requests that
# name any other ad account are refused before they are sent, and account
# discovery only returns these accounts.
PINTEREST_AD_ACCOUNT_IDS=

# Optional. Saves passing adAccountId on every call. It must be one of the
# accounts above. When PINTEREST_AD_ACCOUNT_IDS is unset, this account alone
# is allowed.
# PINTEREST_AD_ACCOUNT_ID=

# Write tools are OFF by default. Set to true to register the 30 write tools.
# Only the exact value true enables them; any value other than true or false
# stops the server at startup. They need the ads:write scope, not just ads:read.
# Every write still previews first and applies only on a second call
# with confirm: true.
# PINTEREST_ENABLE_WRITES=true

# debug | info | warn | error
# LOG_LEVEL=info

# API environment: production or sandbox
PINTEREST_ENVIRONMENT=production
